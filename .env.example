# Freqtrade Neobroker Dashboard Configuration
# Copy this file to .env.local and configure your Freqtrade credentials

# Freqtrade REST API Server URL (e.g. http://localhost:8080 or http://192.168.1.100:8080)
VITE_FREQTRADE_URL=http://localhost:8080

# Basic Auth Credentials (configured in your Freqtrade config.json under api_server)
VITE_FREQTRADE_USER=
VITE_FREQTRADE_PASSWORD=

# Default polling interval in milliseconds (default: 12000 = 12 seconds)
VITE_POLL_INTERVAL=12000

# Enable Demo Mode by default (true / false)
VITE_DEMO_MODE=false
